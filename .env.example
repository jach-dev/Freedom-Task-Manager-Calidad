# ==============================================================
# PLANTILLA DE VARIABLES LOCALES (.env)
# Copia este archivo como `.env` en la raíz del proyecto y
# completa los valores con los de tu entorno local.
# OJO: el archivo `.env` NO se sube a GitHub.
# ==============================================================

# Usuario de MySQL
DB_USERNAME=root

# Contraseña de MySQL
DB_PASSWORD=tu_contraseña_mysql

# Clave secreta para firmar los tokens JWT.
# Genera una con: openssl rand -base64 48
JWT_SECRET=tu_secreto_jwt_generado
